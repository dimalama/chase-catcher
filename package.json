{
  "name": "chase-catcher",
  "version": "2.0.0",
  "description": "Browser extension (Chrome, Firefox, Safari) to automatically activate Chase credit card offers",
  "main": "src/js/background.ts",
  "scripts": {
    "build": "webpack --config config/webpack.config.js && node config/build-targets.js",
    "watch": "webpack --watch --config config/webpack.config.js",
    "test": "jest --config config/jest.config.js --ci --coverage --passWithNoTests",
    "test:watch": "jest --watch --config config/jest.config.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config config/eslint.config.mjs src/",
    "lint:fix": "eslint --config config/eslint.config.mjs src/ --fix",
    "format": "prettier --config config/.prettierrc --write src/",
    "format:check": "prettier --config config/.prettierrc --check src/",
    "clean": "rm -rf dist/ build/ coverage/ package/ chase-catcher*.zip",
    "package": "npm run clean && webpack --config config/webpack.config.js && node config/build-targets.js --zip",
    "lint:firefox": "npx --yes web-ext lint --source-dir build/firefox",
    "safari:xcode": "xcrun safari-web-extension-converter build/safari --project-location safari-xcode --app-name \"Chase Catcher\" --bundle-identifier com.dimalama.chasecatcher --swift --copy-resources --no-open --no-prompt --force"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimalama/chase-catcher"
  },
  "keywords": [
    "chrome-extension",
    "firefox-addon",
    "safari-web-extension",
    "webextension",
    "chase",
    "credit-card",
    "rewards",
    "automation"
  ],
  "author": "Dima Lukianenko",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "overrides": {
    "test-exclude": "^7.0.2",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
